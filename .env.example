# Required
OPENROUTER_API_KEY=

# Optional — all default to the values below (see docs/CONTRACT.md section 4)
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_MODEL_DEVELOPER=cohere/north-mini-code:free
OPENROUTER_FALLBACK_MODELS=minimax/minimax-m2.7:free,minimax/minimax-m3:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free

# Optional — Slack is disabled if either token is missing
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional — dashboard/server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional — feature flags
AGENTFLOW_ENABLE_RAG=false

# Optional — only used if the OpenRouter model catalog cannot be reached; when true,
# accepts model ids ending in ":free" or equal to "openrouter/free" without live pricing
# confirmation, and marks pricing_status as "OFFLINE-HEURISTIC".
AGENTFLOW_ALLOW_OFFLINE_VERIFY=false
